{
  "info": {
    "name": "raf",
    "description": "Publish ProtoJSON to Kafka and inspect recent Protobuf records. For Docker Compose, set base_url to http://localhost:18080. The type query parameter can be omitted when RAF_TOPIC_TYPES defines a default for the topic.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "topic", "value": "example.events" },
    { "key": "message_type", "value": "example.Event" },
    { "key": "message_key", "value": "example-1" }
  ],
  "item": [
    {
      "name": "List loaded Protobuf types",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/types"
      }
    },
    {
      "name": "Publish Protobuf message",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Raf-Headers", "value": "{\"id\":\"manual-test-1\"}" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"id\": \"example-1\",\n  \"status\": \"CREATED\"\n}"
        },
        "url": "{{base_url}}/topics/{{topic}}/messages?type={{message_type}}&key={{message_key}}"
      }
    },
    {
      "name": "Inspect recent messages",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/topics/{{topic}}/messages?type={{message_type}}&limit=10"
      }
    },
    {
      "name": "Publish using configured topic type",
      "request": {
        "description": "Requires an entry for this topic in RAF_TOPIC_TYPES. The Compose example configures example.events as example.Event.",
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"id\": \"example-1\",\n  \"status\": \"CREATED\"\n}"
        },
        "url": "{{base_url}}/topics/{{topic}}/messages?key={{message_key}}"
      }
    },
    {
      "name": "Inspect using configured topic type",
      "request": {
        "description": "Requires an entry for this topic in RAF_TOPIC_TYPES.",
        "method": "GET",
        "url": "{{base_url}}/topics/{{topic}}/messages?limit=10"
      }
    }
  ]
}
